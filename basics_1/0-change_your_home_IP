#!/usr/bin/env bash
# Configures /etc/hosts: localhost resolves to 127.0.0.2 and facebook.com to 8.8.8.8
cp /etc/hosts /tmp/hosts_bak
sed '/localhost/s/127\.0\.0\.1/127.0.0.2/' /tmp/hosts_bak > /tmp/hosts_new
grep -q "facebook\.com" /tmp/hosts_new || echo "8.8.8.8 facebook.com" >> /tmp/hosts_new
sed 's/.*facebook\.com.*/8.8.8.8 facebook.com/' /tmp/hosts_new > /tmp/hosts_final
cp /tmp/hosts_final /etc/hosts
